# Local SQLite database (relative to the project root). Git-ignored.
DATABASE_URL="file:./prisma/dev.db"

# Base URL used for canonical / Open Graph links (baked in at build time).
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Base URL the server uses at runtime for payment return URLs, redirects and
# links in confirmation emails. Must match where the app is actually served.
APP_URL="http://localhost:3000"

# Cookie security. Leave both "false" for http://localhost.
# Phase 4 (HTTPS behind nginx): set COOKIE_SECURE="true", or TRUST_PROXY="true"
# to trust the proxy's X-Forwarded-Proto header.
COOKIE_SECURE="false"
TRUST_PROXY="false"

# ---------------------------------------------------------------------------
# Phase 2: payments
# ---------------------------------------------------------------------------
# "mock" (default, fully offline) or "stripe" (Stripe Checkout in TEST mode).
PAYMENT_PROVIDER="mock"

# The mock provider is disabled in production builds unless this is "true"
# (used only for the local demo and the e2e tests).
ALLOW_MOCK_PAYMENTS="false"

# Secret used to sign mock webhook events. Any long random string.
# Optional in development (a dev-only default is used); required when
# ALLOW_MOCK_PAYMENTS="true" in production.
MOCK_WEBHOOK_SECRET=""

# Stripe TEST keys, only needed when PAYMENT_PROVIDER="stripe".
# Use keys that start with sk_test_ and whsec_ from your Stripe sandbox.
# Never use live keys and never commit your .env file.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
